{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teal.example/schema/policy_v1_3.schema.json",
  "title": "TEAL Policy Schema v1.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "rules", "ttl_minutes", "sweep_minutes"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Policy schema version. Updated to 1.3.",
      "const": "1.3"
    },
    "default_effect": {
      "type": "string",
      "enum": ["allow", "deny", "need_approval", "audit_only"]
    },
    "default_reason": { "type": "string" },
    "ttl_minutes": { "type": "integer", "minimum": 1 },
    "sweep_minutes": { "type": "integer", "minimum": 1 },
    "pre_approval_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "ttl_sec_default" ],
      "properties": {
        "ttl_sec_default": {
          "type": "integer",
          "minimum": 1,
          "description": "Default TTL (seconds) for JIT_ALLOW when rule.pre_approval.ttl_sec is not specified."
        },
        "ttl_sec_max": {
          "type": "integer",
          "minimum": 1,
          "description": "Hard upper bound (seconds) for any JIT TTL. If a rule's chosen TTL exceeds this value, policy compilation MUST fail."
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "action", "effect"],
      "properties": {
        "rule_type": {
          "type": "string",
          "enum": ["standard", "subject_only"],
          "default": "standard",
          "description": "ルールの評価方式。'subject_only'を指定した場合、objectの評価(パス照合)を完全にスキップする。"
        },
        "id": { "type": "string" },
        "subject": { "$ref": "#/$defs/subject" },
        "object": { "$ref": "#/$defs/object" },
        "action": { "$ref": "#/$defs/action" },
        "effect": {
          "type": "string",
          "enum": ["allow", "deny", "need_approval", "audit_only"]
        },
        "audit_level": {
          "type": "string",
          "enum": ["silent", "standard", "strict"],
          "default": "standard"
        },
        "ttl_sec": {
          "type": "integer",
          "minimum": 0,
          "description": "Fast Path cache duration (Ticket TTL). 0 = No Cache, >0 = Cache Enabled."
        },
        "max_uses": {
          "type": "integer",
          "minimum": 0,
          "default": 1,
          "description": "Maximum number of times the ticket can be used."
        },
        "pre_approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "required_roles": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "threshold": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum number of approvals required when effect is need_approval."
        },
        "reason": { "type": "string" },
        "ticket_profile": {
          "type": "object",
          "description": "プロセスベースの高速化（Fast Path）およびチケット継承の設定",
          "additionalProperties": false,
          "properties": {
            "allow_nameless_ipc": {
              "type": "boolean",
              "description": "trueの場合、このプロセスによるソケットやパイプ等の名無しオブジェクトへのアクセスを、パス文字列評価なしで即時許可する (O(1)バイパス)",
              "default": false
            },
            "silent_io": {
              "type": "boolean",
              "description": "trueの場合、このプロセスによるテンポラリ/無名ファイルへのI/Oログを抑制し、即時許可する (0x01)",
              "default": false
            },
            "inherit": {
              "type": "boolean",
              "description": "trueの場合、この権限を子プロセスにも自動継承させる (0x02)",
              "default": false
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["rule_type"],
            "properties": { "rule_type": { "const": "subject_only" } }
          },
          "then": {
            "properties": {
              "object": { "maxProperties": 0 }
            }
          },
          "else": {
            "required": ["object"]
          }
        },
        {
          "if": {
            "properties": { "effect": { "const": "need_approval" } }
          },
          "then": {
            "required": ["required_roles", "threshold"]
          }
        },
        {
          "if": {
            "required": ["pre_approval"],
            "properties": {
              "pre_approval": {
                "properties": { "enabled": { "const": true } }
              }
            }
          },
          "then": {
            "properties": { "effect": { "const": "need_approval" } }
          }
        },
        {
          "if": {
            "required": ["pre_approval"],
            "properties": {
              "pre_approval": {
                "properties": { "enabled": { "const": true } }
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "allOf": [
                  { "$ref": "#/$defs/subject" },
                  {
                    "anyOf": [
                      { "required": ["user"] },
                      { "required": ["uid"] },
                      { "required": ["roles"] }
                    ]
                  },
                  { "required": ["origin_program"] }
                ]
              }
            }
          }
        }
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": { "type": "string" },
        "uid": { "type": "integer", "minimum": 0 },
        "roles": { "type": "array", "items": { "type": "string" } },
        "origin_program": { "type": "string" },
        "origin_script": { "type": "string" },
	    "origin_applet": { "type": "string" }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ops": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    }
  }
}

