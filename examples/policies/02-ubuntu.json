{
  "version": "1.4",
  "system_type": "workstation",
  "default_effect": "allow",
  "default_reason": "No matching rule; default allow.",
  "ttl_minutes": 60,
  "sweep_minutes": 5,
  "pre_approval_defaults": {
    "ttl_sec_default": 600,
    "ttl_sec_max": 900
  },
  "rules": [
    {
      "id": "allow_teal_keys",
      "rule_type": "standard",
      "subject": {
        "user": "toshiyuki",
        "login_context": {
          "require_interactive_tty": true,
          "bind_registered_session": true
        }
      },
      "object": {
        "path": "prefix:/home/toshiyuki/.teal"
      },
      "action": {
        "ops": [
          "READ", "WRITE"
        ]
      },
      "effect": "allow",
      "audit_level": "standard",
      "max_uses": 1,
      "reason": "protect the key files for teal control",
      "ticket_profile": {
        "silent_io": false,
        "inherit": false,
        "allow_nameless_ipc": false
      }
    }
  ]
}
