{
  "version": "1.4",
  "system_type": "workstation",
  "default_effect": "allow",
  "default_reason": "No matching rule; default allow.",
  "ttl_minutes": 60,
  "sweep_minutes": 5,
  "pre_approval_defaults": {
    "ttl_sec_default": 600,
    "ttl_sec_max": 900
  },
  "rules": [
    {
      "id": "auto_allow_xfce4-terminal_ops_9",
      "rule_type": "standard",
      "subject": {
        "roles": ["admin", "security_officer"],
        "origin_program": "/usr/bin/xfce4-terminal",
        "origin_applet": "bash",
        "login_context": {
          "require_interactive_tty": true,
          "bind_registered_session": true
        }
      },
      "object": {
        "path": "/usr/local/bin/teal-cli"
      },
      "action": {
        "ops": [
          "READ"
        ]
      },
      "effect": "allow",
      "audit_level": "standard",
      "max_uses": 1,
      "pre_approval": {
        "enabled": false,
        "ttl_sec": 3600
      },
      "reason": "Auto-generated allow draft",
      "ticket_profile": {
        "silent_io": false,
        "inherit": false,
        "allow_nameless_ipc": false
      }
    },
    {
      "id": "allow_teal_cli_access",
      "rule_type": "standard",
      "subject": {
        "roles": ["admin", "security_officer"],
        "origin_program": "/usr/bin/bash",
        "origin_applet": "bash",
        "login_context": {
          "require_interactive_tty": true,
          "bind_registered_session": true
        }
      },
      "object": {
        "path": "/usr/local/bin/teal-cli"
      },
      "action": {
        "ops": [
          "READ",
          "EXECUTE"
        ]
      },
      "effect": "allow",
      "audit_level": "standard",
      "max_uses": 1,
      "pre_approval": {
        "enabled": false,
        "ttl_sec": 3600
      },
      "reason": "control teal-cli command run",
      "ticket_profile": {
        "silent_io": false,
        "inherit": false,
        "allow_nameless_ipc": false
      }
    }
  ]
}
