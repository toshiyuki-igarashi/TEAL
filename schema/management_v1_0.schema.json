{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/management.schema.json",
  "title": "TEAL Management Policy Schema v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["roles", "controls"],
  "properties": {
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/managementRole" }
    },
    "controls": {
      "$ref": "#/$defs/controls"
    }
  },
  "$defs": {
    "managementRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "uids"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z][a-zA-Z0-9_:\\-\\.]{0,63}$",
          "description": "管理ロール名"
        },
        "uids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "description": {
          "type": "string",
          "maxLength": 2048
        }
      }
    },

    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "stop"],
      "properties": {
        "start": { "$ref": "#/$defs/control" },
        "stop":  { "$ref": "#/$defs/control" }
      }
    },

    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initiator_roles", "mpa"],
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 2048
        },
        "initiator_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/roleNameRef" }
        },
        "mpa": { "$ref": "#/$defs/mpa" }
      }
    },

    "mpa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "approver_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/roleNameRef" }
        },
        "timeout_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440,
          "default": 30
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "required": ["threshold", "approver_roles", "timeout_minutes"]
          }
        }
      ]
    },

    "roleNameRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-zA-Z][a-zA-Z0-9_:\\-\\.]{0,63}$"
    }
  }
}

